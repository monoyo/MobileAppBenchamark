<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
   xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:paddingStart="32dp"
   android:paddingEnd="32dp"
   android:paddingTop="52dp"
   android:paddingBottom="52dp">

    <TextView
            android:id="@+id/currentTestInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            android:text="Benchmark Suite" />

    <ProgressBar
            android:id="@+id/testProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:progressTint="#443FD8"
            android:backgroundTint="#EEEEEE"
            app:layout_constraintTop_toBottomOf="@id/currentTestInfo" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#FAFAFA"
            app:layout_constraintTop_toBottomOf="@id/testProgress"
            app:layout_constraintBottom_toTopOf="@id/controlButtons">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/testSelectionContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <CheckBox
                    android:id="@+id/checkUi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UI Stress Test"
                    android:checked="true"/>
                <CheckBox
                    android:id="@+id/checkCpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CPU Test"
                    android:checked="true"/>
                <CheckBox
                    android:id="@+id/checkRam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RAM Test"
                    android:checked="true"/>
                <CheckBox
                    android:id="@+id/checkImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Image Loading Test"
                    android:checked="true"/>
                <CheckBox
                    android:id="@+id/checkApi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API Test"
                    android:checked="true"/>
                <CheckBox
                    android:id="@+id/checkLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Location Test"
                    android:checked="true"/>
            </LinearLayout>

            <TextView
                android:id="@+id/testResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#000000" />
        </LinearLayout>

    </ScrollView>

    <LinearLayout
            android:id="@+id/controlButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent">

        <Button
                android:id="@+id/startTestsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Tests"
                android:backgroundTint="#443FD8"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                android:layout_marginEnd="8dp"/>

        <Button
                android:id="@+id/exportResultsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export Results"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#443FD8"
                app:strokeColor="#443FD8"
                app:cornerRadius="8dp"
                android:layout_marginStart="8dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
